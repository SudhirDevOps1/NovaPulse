{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["public/sw.js"],
	"exclude": ["node_modules"]
}
