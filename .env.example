# Copy to .env — every value is optional.
#
#   Docker Compose reads this file directly (`env_file: .env`).
#   `npm start` / `node server.js` do NOT parse it: use your shell, systemd's
#   EnvironmentFile, `docker run --env-file .env`, or `node --env-file=.env server.js`.
#
# ⚠ NovaPulse ships NO built-in authentication. Anything that can reach this
#   port can read and change every monitor. Do not expose it to the internet
#   without a reverse proxy / identity-aware access layer. See docs/SECURITY.md.

# --- runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3000                 # container/compose port (host mapping uses ${PORT} too)
HOST=0.0.0.0              # bind address; keep 0.0.0.0 inside containers
UPTIME_DATA_DIR=./data    # where monitors.json lives (Docker image uses /app/data)

# --- logging -----------------------------------------------------------------
LOG_LEVEL=info            # debug | info | warn | error | silent
LOG_FORMAT=pretty         # pretty (dev) | json (production/log aggregation)

# --- network -----------------------------------------------------------------
TRUST_PROXY=loopback      # set to '1' behind Render/Fly/Nginx so rate limits and
                          # client IPs see the real origin
ALLOW_ORIGIN=             # comma-separated origins, only if the API is called cross-site
RATE_LIMIT=               # set to "off" to disable the built-in limiter
RATE_LIMIT_MAX=240        # requests per window (per IP)

# --- optional alerts (any mix; Settings shows a health pill per channel) ------
TELEGRAM_BOT_TOKEN=         # Telegram bot token from @BotFather
TELEGRAM_CHAT_ID=           # chat/channel id to post into
DISCORD_WEBHOOK_URL=        # Discord channel webhook URL
SLACK_WEBHOOK_URL=          # Slack incoming webhook (BlockKit)
NTFY_URL=                   # e.g. https://ntfy.sh/novapulse-alerts
NTFY_TOKEN=                 # optional ntfy access token
WEBHOOK_URL=                # generic JSON POST endpoint
WEBHOOK_SECRET=             # sent as x-novapulse-secret with webhook calls

# --- optional alert rules -----------------------------------------------------
ALERT_ON_DEGRADED=          # "1" also notify when a monitor turns Slow/degraded
ALERT_COOLDOWN_MS=300000    # min gap between two alerts of the same kind for one
                            # monitor (0 = unthrottled). Damps flapping endpoints.
SSL_WARN_DAYS=14            # warn N days before certificate expiry
SLA_TARGET=99.9             # SLA target % shown in the dashboard (50-100)

# --- probing safety -----------------------------------------------------------
ALLOW_PRIVATE_TARGETS=      # leave EMPTY. "1" lets probes reach loopback,
                            # RFC1918 and link-local/metadata addresses — only
                            # for deliberately monitoring your own LAN. Without
                            # it every such target is refused (SSRF guard).

# --- optional serverless database backends (choose any) -----------------------
# Turso libSQL
TURSO_DATABASE_URL=           # e.g. https://your-db-org.turso.io
TURSO_AUTH_TOKEN=             # your Turso database auth token

# Neon Serverless Postgres
NEON_DATABASE_URL=            # e.g. postgres://user:pass@ep-cool-123.neon.tech/neondb?sslmode=require

# Aiven Managed Postgres / MySQL
AIVEN_DATABASE_URL=           # e.g. postgres://avnadmin:pass@pg-host.aivencloud.com:25345/defaultdb?sslmode=require

# --- optional Upptime-grade GitHub Issues & Git commit storage ----------------
GITHUB_TOKEN=                 # Personal access token with repo/issues permissions
GITHUB_REPOSITORY=            # e.g. SudhirDevOps1/NovaPulse
GITHUB_STORAGE=false          # "true" to commit status files to GitHub repo

# --- optional Google Maps Platform 3D Global Telemetry -----------------------
GOOGLE_MAPS_API_KEY=          # Google Maps Platform JavaScript API Key (with marker library)

# --- serverless cron & GitHub Issues -----------------------------------------
CRON_SECRET=                # shared secret required by POST /api/cron (Vercel
                            # cron). The only credential gate in the app.
GH_PAT=                     # fallback token for GitHub Issues automation, used
                            # when GITHUB_TOKEN is unset

# --- development only --------------------------------------------------------
ALLOW_FRAMING=                # "1" relaxes frame-ancestors for the local QA harness
